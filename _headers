/*
  Static asset caching for Netlify/Cloudflare Pages-style hosts.
  GitHub Pages ignores this file; the service worker still provides client-side caching on HTTPS.
*/
/assets/css/app.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/js/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/js/sw-register.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sw.js
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate
